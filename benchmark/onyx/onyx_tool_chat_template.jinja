{{- bos_token -}}
{%- macro render_parts(content) -%}
{%- if content is string -%}{{- content -}}
{%- else -%}
{%- for part in content -%}
{%- if part['type'] == 'image' -%}{{- '<|image|>' -}}
{%- elif part['type'] == 'video' -%}{{- '<|video|>' -}}
{%- elif part['type'] == 'text' -%}{{- part['text'] -}}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- set tool_prompt = '' -%}
{%- if tools is defined and tools -%}
{%- set tool_prompt = ' You have access to functions. Available functions: ' + (tools | tojson) + '. When a function is needed, send your assistant message to the function name as recipient and put only JSON arguments in the message. After receiving a tool result, use it to answer the user instead of repeating the same call.' -%}
{%- endif -%}
{%- set ns = namespace(has_system=false) -%}
{%- for m in messages -%}
{%- if m['role'] == 'system' -%}{%- set ns.has_system = true -%}{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt and not ns.has_system -%}
{{- '<|start|>system<|message|>You are a helpful assistant.' + tool_prompt + '<|eot|>' -}}
{%- endif -%}
{%- for message in messages -%}
{%- set role = message['role'] -%}
{%- if role == 'assistant' -%}
{%- set tool_calls = message.get('tool_calls') -%}
{%- if tool_calls and tool_calls | length > 1 -%}
{{- raise_exception('Onyx supports one tool call per assistant turn; set parallel_tool_calls=false') -}}
{%- endif -%}
{%- set recipient = tool_calls[0]['function']['name'] if tool_calls else message.get('recipient') -%}
{%- set end_turn = message.get('end_turn') -%}
{%- if end_turn is none -%}
{%- set end_turn = not (recipient and recipient != 'user') -%}
{%- endif -%}
{{- '<|start|>assistant' -}}
{%- if recipient -%}{{- ' to=' + recipient -}}{%- endif -%}
{{- '<|message|>' -}}
{%- if tool_calls -%}
{%- set arguments = tool_calls[0]['function']['arguments'] -%}
{{- arguments if arguments is string else arguments | tojson -}}
{%- else -%}
{{- render_parts(message.get('content', '')) -}}
{%- endif -%}
{{- ('<|eot|>' if end_turn else '<|eom|>') -}}
{%- elif role == 'tool' -%}
{%- set tool_ns = namespace(name=message.get('name', '')) -%}
{%- if not tool_ns.name and message.get('tool_call_id') -%}
{%- for prior in messages -%}
{%- if prior['role'] == 'assistant' and prior.get('tool_calls') -%}
{%- for tool_call in prior['tool_calls'] -%}
{%- if tool_call.get('id') == message['tool_call_id'] -%}{%- set tool_ns.name = tool_call['function']['name'] -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- set name = tool_ns.name -%}
{%- if not name -%}
{{- raise_exception('Onyx tool messages require a name or a matching tool_call_id') -}}
{%- endif -%}
{{- '<|start|>tool ' + name + '<|message|>' -}}{{- render_parts(message['content']) -}}{{- '<|eot|>' -}}
{%- else -%}
{%- set header = role -%}
{%- if message.get('name') -%}{%- set header = role + ' ' + message['name'] -%}{%- endif -%}
{{- '<|start|>' + header + '<|message|>' -}}{{- render_parts(message['content']) -}}
{%- if role == 'system' and tool_prompt -%}{{- tool_prompt -}}{%- endif -%}
{{- '<|eot|>' -}}
{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}{{- '<|start|>assistant' -}}{%- endif -%}
