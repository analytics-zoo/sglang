{{- bos_token -}}
{%- macro render_parts(content) -%}
{%- if content is string -%}{{- content -}}
{%- else -%}
{%- for part in content -%}
{%- if part['type'] == 'image' -%}{{- '<|image|>' -}}
{%- elif part['type'] == 'video' -%}{{- '<|video|>' -}}
{%- elif part['type'] == 'text' -%}{{- part['text'] -}}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- set tool_prompt = '' -%}
{%- if tools is defined and tools -%}
{%- set tool_prompt = ' You have access to functions. Available functions: ' + (tools | tojson) + '. Decide whether a function is actually needed and call only the minimum functions required for the user\'s explicit request. You may make at most one short private self-recipient decision before responding. Never narrate, promise, or announce an intended function call to the user; either call the function or give the user a normal answer. When a function is needed, send the assistant message to that function name as recipient and put exactly one JSON object in the message. Call at most one function in each assistant response, then wait for its result before deciding the next step. A successful tool result completes that action. If it satisfies the request, answer the user and stop calling functions; continue only when another explicit part of the current request remains. Do not call functions merely to verify, reformat, navigate after, undo, or repeat an action that already succeeded, unless the user explicitly requested that additional action. Within one user turn, do not repeat the same function with identical arguments unless its previous result explicitly reports a temporary or retryable failure. If a tool reports a non-retryable error, change the arguments or plan, or explain why the task is blocked. Do not ask the user to repeat values already stated in the request. Treat a supplied access token, access code, or authorization code as available authorization for a compatible function. If a requested target state requires an unknown current value and a listed status function directly provides it, use that status function. Use a listed calculation or conversion function when the user requests that operation. Otherwise, do not call unrelated functions for arithmetic, translation, explanations, or stable general knowledge. Function arguments must start with { and end with }; never use XML for function arguments. This argument rule does not apply to normal user replies.' -%}
{%- endif -%}
{%- set ns = namespace(has_system=false) -%}
{%- for m in messages -%}
{%- if m['role'] == 'system' -%}{%- set ns.has_system = true -%}{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt and not ns.has_system -%}
{{- '<|start|>system<|message|>You are a helpful assistant.' + tool_prompt + '<|eot|>' -}}
{%- endif -%}
{%- for message in messages -%}
{%- set role = message['role'] -%}
{%- if role == 'assistant' -%}
{%- set tool_calls = message.get('tool_calls') -%}
{%- if tool_calls and tool_calls | length > 1 -%}
{{- raise_exception('Onyx supports one tool call per assistant turn') -}}
{%- endif -%}
{%- set recipient = tool_calls[0]['function']['name'] if tool_calls else message.get('recipient') -%}
{%- set end_turn = message.get('end_turn') -%}
{%- if end_turn is none -%}
{%- set end_turn = not (recipient and recipient != 'user') -%}
{%- endif -%}
{{- '<|start|>assistant' -}}
{%- if recipient -%}{{- ' to=' + recipient -}}{%- endif -%}
{{- '<|message|>' -}}
{%- if tool_calls -%}
{%- set arguments = tool_calls[0]['function']['arguments'] -%}
{{- arguments if arguments is string else arguments | tojson -}}
{%- else -%}
{{- render_parts(message.get('content', '')) -}}
{%- endif -%}
{{- ('<|eot|>' if end_turn else '<|eom|>') -}}
{%- elif role == 'tool' -%}
{%- set tool_ns = namespace(name=message.get('name', '')) -%}
{%- if not tool_ns.name and message.get('tool_call_id') -%}
{%- for prior in messages -%}
{%- if prior['role'] == 'assistant' and prior.get('tool_calls') -%}
{%- for tool_call in prior['tool_calls'] -%}
{%- if tool_call.get('id') == message['tool_call_id'] -%}{%- set tool_ns.name = tool_call['function']['name'] -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- set name = tool_ns.name -%}
{%- if not name -%}
{{- raise_exception('Onyx tool messages require a name or a matching tool_call_id') -}}
{%- endif -%}
{{- '<|start|>tool ' + name + '<|message|>' -}}{{- render_parts(message['content']) -}}{{- '<|eot|>' -}}
{%- else -%}
{%- set header = role -%}
{%- if message.get('name') -%}{%- set header = role + ' ' + message['name'] -%}{%- endif -%}
{{- '<|start|>' + header + '<|message|>' -}}{{- render_parts(message['content']) -}}
{%- if role == 'system' and tool_prompt -%}{{- tool_prompt -}}{%- endif -%}
{{- '<|eot|>' -}}
{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}{{- '<|start|>assistant' -}}{%- endif -%}
